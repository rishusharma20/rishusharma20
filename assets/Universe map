<svg viewBox="0 0 1200 640" xmlns="http://www.w3.org/2000/svg" width="100%" role="img" aria-label="Constellation map of Rishu's technology ecosystem">
  <defs>
    <radialGradient id="mapBg" cx="50%" cy="50%" r="75%">
      <stop offset="0%" stop-color="#0B1230"/>
      <stop offset="100%" stop-color="#030712"/>
    </radialGradient>
    <filter id="nodeGlow" x="-100%" y="-100%" width="300%" height="300%">
      <feGaussianBlur stdDeviation="3.2" result="b"/>
      <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>
  <rect width="1200" height="640" fill="url(#mapBg)"/>

  <g fill="#F8FAFC">
    <circle cx="80" cy="60" r="1.2" opacity="0.6"><animate attributeName="opacity" values="0.2;0.9;0.2" dur="3.4s" repeatCount="indefinite"/></circle>
    <circle cx="1100" cy="80" r="1.3" opacity="0.6"><animate attributeName="opacity" values="0.7;0.15;0.7" dur="2.9s" repeatCount="indefinite"/></circle>
    <circle cx="60" cy="560" r="1.4" opacity="0.6"><animate attributeName="opacity" values="0.3;1;0.3" dur="3.7s" repeatCount="indefinite"/></circle>
    <circle cx="1140" cy="580" r="1.1" opacity="0.5"><animate attributeName="opacity" values="0.8;0.2;0.8" dur="2.5s" repeatCount="indefinite"/></circle>
    <circle cx="600" cy="30" r="1.2" opacity="0.6"><animate attributeName="opacity" values="0.2;0.9;0.2" dur="4.1s" repeatCount="indefinite"/></circle>
    <circle cx="600" cy="610" r="1.2" opacity="0.6"><animate attributeName="opacity" values="0.6;0.15;0.6" dur="3.2s" repeatCount="indefinite"/></circle>
  </g>

  <!-- central node: RISHU -->
  <g transform="translate(600,320)">
    <circle r="52" fill="none" stroke="#8B5CF6" stroke-width="1" opacity="0.4"/>
    <circle r="34" fill="#0B1230" stroke="#E879F9" stroke-width="1.6" filter="url(#nodeGlow)"/>
    <text text-anchor="middle" y="5" font-family="JetBrains Mono, Consolas, monospace" font-size="13" fill="#F8FAFC" font-weight="700">RISHU</text>
  </g>

  <!-- category hub positions -->
  <!-- CORE top-left, BACKEND top-right, FRONTEND right, DATABASE bottom-right, TOOLS bottom-left, AI/ML left -->

  <g stroke="#4F8CFF" stroke-width="1" opacity="0.45">
    <line x1="600" y1="320" x2="260" y2="140"/>
    <line x1="600" y1="320" x2="940" y2="140"/>
    <line x1="600" y1="320" x2="1020" y2="360"/>
    <line x1="600" y1="320" x2="900" y2="540"/>
    <line x1="600" y1="320" x2="300" y2="540"/>
    <line x1="600" y1="320" x2="180" y2="330"/>
  </g>

  <!-- CORE hub -->
  <g font-family="Space Grotesk, Segoe UI, sans-serif">
    <g transform="translate(260,140)">
      <circle r="8" fill="#4F8CFF" filter="url(#nodeGlow)"/>
      <text x="0" y="-20" text-anchor="middle" font-size="13" fill="#22D3EE" letter-spacing="2">CORE</text>
      <g font-family="JetBrains Mono, Consolas, monospace" font-size="11.5" fill="#C7D2FE">
        <text x="-95" y="10">☄ Java</text>
        <text x="-95" y="30">☄ C++</text>
        <text x="-95" y="50">☄ JavaScript</text>
        <text x="20" y="10">☄ TypeScript</text>
        <text x="20" y="30">☄ Python</text>
      </g>
      <g stroke="#4F8CFF" stroke-width="0.6" opacity="0.4">
        <line x1="0" y1="0" x2="-90" y2="6"/>
        <line x1="0" y1="0" x2="-90" y2="26"/>
        <line x1="0" y1="0" x2="-90" y2="46"/>
        <line x1="0" y1="0" x2="15" y2="6"/>
        <line x1="0" y1="0" x2="15" y2="26"/>
      </g>
    </g>

    <!-- BACKEND hub -->
    <g transform="translate(940,140)">
      <circle r="8" fill="#22D3EE" filter="url(#nodeGlow)"/>
      <text x="0" y="-20" text-anchor="middle" font-size="13" fill="#22D3EE" letter-spacing="2">BACKEND</text>
      <g font-family="JetBrains Mono, Consolas, monospace" font-size="11.5" fill="#C7D2FE">
        <text x="20" y="10">☄ Spring Boot</text>
        <text x="20" y="30">☄ Node.js</text>
        <text x="20" y="50">☄ Express.js</text>
        <text x="20" y="70">☄ REST APIs</text>
      </g>
      <g stroke="#22D3EE" stroke-width="0.6" opacity="0.4">
        <line x1="0" y1="0" x2="15" y2="6"/>
        <line x1="0" y1="0" x2="15" y2="26"/>
        <line x1="0" y1="0" x2="15" y2="46"/>
        <line x1="0" y1="0" x2="15" y2="66"/>
      </g>
    </g>

    <!-- FRONTEND hub -->
    <g transform="translate(1020,360)">
      <circle r="8" fill="#4F8CFF" filter="url(#nodeGlow)"/>
      <text x="30" y="4" font-size="13" fill="#22D3EE" letter-spacing="2">FRONTEND</text>
      <g font-family="JetBrains Mono, Consolas, monospace" font-size="11.5" fill="#C7D2FE">
        <text x="30" y="24">☄ React</text>
        <text x="30" y="44">☄ Next.js</text>
        <text x="30" y="64">☄ Tailwind CSS</text>
      </g>
      <g stroke="#4F8CFF" stroke-width="0.6" opacity="0.4">
        <line x1="0" y1="0" x2="25" y2="19"/>
        <line x1="0" y1="0" x2="25" y2="39"/>
        <line x1="0" y1="0" x2="25" y2="59"/>
      </g>
    </g>

    <!-- DATABASE hub -->
    <g transform="translate(900,540)">
      <circle r="8" fill="#8B5CF6" filter="url(#nodeGlow)"/>
      <text x="0" y="34" text-anchor="middle" font-size="13" fill="#22D3EE" letter-spacing="2">DATABASE</text>
      <g font-family="JetBrains Mono, Consolas, monospace" font-size="11.5" fill="#C7D2FE">
        <text x="-100" y="-10">☄ MySQL</text>
        <text x="-100" y="10">☄ MongoDB</text>
        <text x="15" y="-10">☄ PostgreSQL</text>
        <text x="15" y="10">☄ Oracle</text>
      </g>
      <g stroke="#8B5CF6" stroke-width="0.6" opacity="0.4">
        <line x1="0" y1="0" x2="-95" y2="-14"/>
        <line x1="0" y1="0" x2="-95" y2="6"/>
        <line x1="0" y1="0" x2="10" y2="-14"/>
        <line x1="0" y1="0" x2="10" y2="6"/>
      </g>
    </g>

    <!-- TOOLS hub -->
    <g transform="translate(300,540)">
      <circle r="8" fill="#4F8CFF" filter="url(#nodeGlow)"/>
      <text x="0" y="34" text-anchor="middle" font-size="13" fill="#22D3EE" letter-spacing="2">TOOLS</text>
      <g font-family="JetBrains Mono, Consolas, monospace" font-size="11.5" fill="#C7D2FE">
        <text x="-110" y="-10">☄ Git</text>
        <text x="-110" y="10">☄ GitHub</text>
        <text x="20" y="-20">☄ Postman</text>
        <text x="20" y="0">☄ VS Code</text>
        <text x="20" y="20">☄ Eclipse</text>
      </g>
      <g stroke="#4F8CFF" stroke-width="0.6" opacity="0.4">
        <line x1="0" y1="0" x2="-100" y2="-14"/>
        <line x1="0" y1="0" x2="-100" y2="6"/>
        <line x1="0" y1="0" x2="15" y2="-24"/>
        <line x1="0" y1="0" x2="15" y2="-4"/>
        <line x1="0" y1="0" x2="15" y2="16"/>
      </g>
    </g>

    <!-- AI/ML hub -->
    <g transform="translate(180,330)">
      <circle r="8" fill="#E879F9" filter="url(#nodeGlow)"/>
      <text x="-30" y="4" text-anchor="end" font-size="13" fill="#22D3EE" letter-spacing="2">AI / ML</text>
      <g font-family="JetBrains Mono, Consolas, monospace" font-size="11.5" fill="#C7D2FE" text-anchor="end">
        <text x="-30" y="-40">☄ Google Gemini</text>
        <text x="-30" y="-20">☄ Machine Learning</text>
        <text x="-30" y="24">☄ Random Forest</text>
        <text x="-30" y="44">☄ Sentence Transformers</text>
        <text x="-30" y="64">☄ Vector Search</text>
      </g>
      <g stroke="#E879F9" stroke-width="0.6" opacity="0.4">
        <line x1="0" y1="0" x2="-25" y2="-44"/>
        <line x1="0" y1="0" x2="-25" y2="-24"/>
        <line x1="0" y1="0" x2="-25" y2="20"/>
        <line x1="0" y1="0" x2="-25" y2="40"/>
        <line x1="0" y1="0" x2="-25" y2="60"/>
      </g>
    </g>
  </g>

  <!-- twinkle pulses on hub nodes -->
  <g fill="none">
    <circle cx="260" cy="140" r="8" stroke="#4F8CFF" stroke-width="1"><animate attributeName="r" values="8;16;8" dur="3.2s" repeatCount="indefinite"/><animate attributeName="opacity" values="0.6;0;0.6" dur="3.2s" repeatCount="indefinite"/></circle>
    <circle cx="940" cy="140" r="8" stroke="#22D3EE" stroke-width="1"><animate attributeName="r" values="8;16;8" dur="3.6s" repeatCount="indefinite"/><animate attributeName="opacity" values="0.6;0;0.6" dur="3.6s" repeatCount="indefinite"/></circle>
    <circle cx="1020" cy="360" r="8" stroke="#4F8CFF" stroke-width="1"><animate attributeName="r" values="8;16;8" dur="2.9s" repeatCount="indefinite"/><animate attributeName="opacity" values="0.6;0;0.6" dur="2.9s" repeatCount="indefinite"/></circle>
    <circle cx="900" cy="540" r="8" stroke="#8B5CF6" stroke-width="1"><animate attributeName="r" values="8;16;8" dur="3.9s" repeatCount="indefinite"/><animate attributeName="opacity" values="0.6;0;0.6" dur="3.9s" repeatCount="indefinite"/></circle>
    <circle cx="300" cy="540" r="8" stroke="#4F8CFF" stroke-width="1"><animate attributeName="r" values="8;16;8" dur="3.1s" repeatCount="indefinite"/><animate attributeName="opacity" values="0.6;0;0.6" dur="3.1s" repeatCount="indefinite"/></circle>
    <circle cx="180" cy="330" r="8" stroke="#E879F9" stroke-width="1"><animate attributeName="r" values="8;16;8" dur="3.4s" repeatCount="indefinite"/><animate attributeName="opacity" values="0.6;0;0.6" dur="3.4s" repeatCount="indefinite"/></circle>
  </g>
</svg>
