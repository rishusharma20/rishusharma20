<svg viewBox="0 0 1200 70" xmlns="http://www.w3.org/2000/svg" width="100%" role="img" aria-label="Cosmic footer divider">
  <defs>
    <linearGradient id="footLine" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#4F8CFF" stop-opacity="0"/>
      <stop offset="50%" stop-color="#22D3EE" stop-opacity="0.7"/>
      <stop offset="100%" stop-color="#8B5CF6" stop-opacity="0"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="70" fill="#030712"/>
  <line x1="0" y1="35" x2="1200" y2="35" stroke="url(#footLine)" stroke-width="1"/>
  <circle cx="600" cy="35" r="4" fill="#22D3EE">
    <animate attributeName="r" values="3;6;3" dur="2.4s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="1;0.4;1" dur="2.4s" repeatCount="indefinite"/>
  </circle>
  <line x1="-30" y1="10" x2="10" y2="25" stroke="#F8FAFC" stroke-width="1.6" stroke-linecap="round" opacity="0">
    <animate attributeName="opacity" values="0;0;1;0" keyTimes="0;0.5;0.58;0.75" dur="7s" repeatCount="indefinite"/>
    <animateTransform attributeName="transform" type="translate" values="0 0; 1250 20" keyTimes="0;1" dur="7s" repeatCount="indefinite"/>
  </line>
</svg>
